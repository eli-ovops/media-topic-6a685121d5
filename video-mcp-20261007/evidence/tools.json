    {
      "name": "video_info",
      "title": "Video metadata",
      "description": "Fast metadata probe (duration, resolution, codecs, audio presence) without transcription or frames.\n\nUse before expensive analysis to plan detail level / time ranges.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute local path, file:// URI, direct media URL, or platform URL (YouTube/TikTok/etc via yt-dlp)"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Response text format"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
